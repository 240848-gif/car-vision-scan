# Copy to .env and fill in. EXPO_PUBLIC_ vars are bundled into the app,
# so for production move the AI call behind your own backend.
EXPO_PUBLIC_AI_API_KEY=your-key-here
# Anthropic Messages API (default). Change src/services/recognize.js to swap providers.
EXPO_PUBLIC_AI_ENDPOINT=https://api.anthropic.com/v1/messages
EXPO_PUBLIC_AI_MODEL=claude-haiku-5-5
